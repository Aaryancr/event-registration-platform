# ==============================================================================
# EventFlow Platform — Production Environment Configuration Template
# Instructions:
# 1. Copy this file to .env.production on your deployment server:
#    cp .env.production.example .env.production
# 2. Replace all placeholder values with strong randomly generated secrets:
#    openssl rand -hex 32
# 3. Restrict file permissions: chmod 600 .env.production
# 4. NEVER commit .env.production to version control.
# ==============================================================================

# Runtime Environment
ENVIRONMENT=production
DEBUG=false

# Database Configuration (PostgreSQL 16)
# Generate a strong password: openssl rand -base64 24
POSTGRES_USER=eventflow_prod_user
POSTGRES_PASSWORD=generate_a_secure_random_db_password_here
POSTGRES_DB=eventflow_production

# JWT Authentication
# Generate a 256-bit secret key: openssl rand -hex 32
JWT_SECRET=generate_a_cryptographically_secure_256bit_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Observability & Metrics Scraper Security
# Generate a random bearer token: openssl rand -hex 24
METRICS_TOKEN=generate_a_secure_metrics_bearer_token_here

# Redis Configuration (Internal Docker Network)
REDIS_HOST=redis
REDIS_PORT=6379

# Database Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
