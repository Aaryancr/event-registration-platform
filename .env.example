# ==============================================================================
# Event Registration Platform - Local Development Environment Variables
# ==============================================================================
# Instructions:
# 1. Copy this template to .env:
#    cp .env.example .env
# 2. Adjust values if needed for your local machine.
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=event_platform
# Host port mapping for PostgreSQL:
# Default to 5433 to avoid conflicts if a local PostgreSQL is running on host port 5432
POSTGRES_PORT=5433

# Redis Configuration
REDIS_PORT=6379

# Backend API Configuration
BACKEND_PORT=8000
ENVIRONMENT=development

# JWT & Authentication Configuration
# Required: Secret key for signing JWT tokens (generate via: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Metrics & Telemetry
METRICS_TOKEN=eventflow-metrics-token-secure

# Frontend Web Configuration
FRONTEND_PORT=5173
